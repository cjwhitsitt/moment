# Example local secret configuration for Firebase Functions Emulator.
# To configure local secrets during development:
# 1. Copy this file to functions/.secret.local:
#    cp functions/.secret.local.example functions/.secret.local
# 2. Replace the placeholder below with your real Resend API key:
#    RESEND_KEY=re_123456789abcdef
# 3. Restart the Firebase emulators.
#
# Note: functions/.secret.local is gitignored and will never be committed.

RESEND_KEY=re_your_resend_api_key_here
